---
const steps = [
  {
    n: "01",
    title: "Call",
    text: "A free 30-minute call. You describe the process; I ask what breaks and what it costs you.",
  },
  {
    n: "02",
    title: "Scope & quote",
    text: "A one-page scope with a fixed price and milestones (40% to start, 40% at the working demo, 20% at launch).",
  },
  {
    n: "03",
    title: "Build in the open",
    text: "A working version within two weeks, then weekly demos. You test on your real data as we go.",
  },
  {
    n: "04",
    title: "Launch & care",
    text: "Deployment, staff training, 30 days of fixes. Then a care plan or hourly, your choice.",
  },
];
---

<ol class="grid gap-6 md:grid-cols-4">
  {
    steps.map((s) => (
      <li class="rounded-2xl border p-6">
        <span class="text-primary font-mono text-sm">{s.n}</span>
        <h3 class="mt-2 text-lg font-semibold">{s.title}</h3>
        <p class="text-muted-foreground mt-2 text-sm leading-snug">{s.text}</p>
      </li>
    ))
  }
</ol>
