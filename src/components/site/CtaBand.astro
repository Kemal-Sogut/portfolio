---
import { Button } from "@/components/ui/button";
import { SITE } from "@/consts";

interface Props {
  heading?: string;
  sub?: string;
}

const {
  heading = "Have a process that still runs on paper or spreadsheets?",
  sub = "Tell me what it is. I will reply within one business day with a rough range and next step.",
} = Astro.props;
---

<section class="container py-20 lg:py-28">
  <div
    class="bg-primary text-primary-foreground rounded-3xl px-6 py-14 text-center md:px-16"
  >
    <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">{heading}</h2>
    <p class="mx-auto mt-4 max-w-xl text-lg opacity-90">{sub}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button asChild size="lg" variant="secondary">
        <a href="/contact">Start a project</a>
      </Button>
      <Button
        asChild
        size="lg"
        variant="ghost"
        className="text-primary-foreground hover:bg-primary-foreground/10 hover:text-primary-foreground"
      >
        <a href={SITE.phoneHref}>Call {SITE.phone}</a>
      </Button>
    </div>
  </div>
</section>
