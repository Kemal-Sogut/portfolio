---
import { getCollection, render } from "astro:content";

import { ArchitectureStrip } from "@/components/diagrams/ArchitectureStrip";
import CtaBand from "@/components/site/CtaBand.astro";
import StackCard from "@/components/site/StackCard.astro";
import { buttonVariants } from "@/components/ui/button";
import DefaultLayout from "@/layouts/DefaultLayout.astro";

export async function getStaticPaths() {
  const work = await getCollection("work");
  return work.map((w) => ({ params: { slug: w.id }, props: { entry: w } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<DefaultLayout title={d.title} description={d.summary}>
  <article class="container pt-28 pb-16 lg:pt-40">
    <p class="text-primary font-mono text-xs tracking-widest uppercase">
      {d.client} · {d.year}
    </p>
    <h1 class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight md:text-5xl">
      {d.title}
    </h1>
    <p class="text-muted-foreground mt-4 max-w-2xl text-lg">{d.summary}</p>

    <div class="mt-6 flex flex-wrap gap-3">
      {
        d.liveUrl && (
          <a
            href={d.liveUrl}
            target="_blank"
            rel="noreferrer"
            class={buttonVariants()}
          >
            Open the live app
          </a>
        )
      }
      {
        d.repoUrl && (
          <a
            href={d.repoUrl}
            target="_blank"
            rel="noreferrer"
            class={buttonVariants({ variant: "outline" })}
          >
            View the code
          </a>
        )
      }
    </div>

    {
      d.metrics.length > 0 && (
        <dl class="mt-10 grid grid-cols-2 gap-6 rounded-2xl border p-6 md:grid-cols-4">
          {d.metrics.map((m) => (
            <div>
              <dd class="font-mono text-3xl font-semibold">
                {`${m.value.toLocaleString()}${m.suffix}`}
              </dd>
              <dt class="text-muted-foreground mt-1 text-sm">{m.label}</dt>
            </div>
          ))}
        </dl>
      )
    }

    <section class="mt-12 border-t pt-10">
      <p
        class="text-muted-foreground font-mono text-xs tracking-widest uppercase"
      >
        How it is put together
      </p>
      <div class="mt-6">
        <ArchitectureStrip
          client:visible
          stack={d.stack}
          title={`How ${d.title} is put together, from browser to data.`}
        />
      </div>
    </section>

    <div class="mt-12 grid gap-10 lg:grid-cols-[1fr_320px]">
      <div class="prose prose-neutral dark:prose-invert max-w-none">
        <Content />
      </div>
      <aside class="space-y-6">
        {
          d.cover ? (
            <img
              src={d.cover}
              alt={`${d.title} screenshot`}
              class="rounded-2xl border"
            />
          ) : (
            <StackCard title="stack" stack={d.stack} />
          )
        }
        <div class="rounded-2xl border p-5 text-sm">
          <p class="font-semibold">Services used</p>
          <ul class="mt-2 space-y-1">
            {
              d.services.map((s) => (
                <li>
                  <a class="hover:underline" href={`/services#${s}`}>
                    {s.replace("-", " ")}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </article>
  <CtaBand heading="Could something like this work for your business?" />
</DefaultLayout>
