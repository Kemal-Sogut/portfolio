---
import { ContactForm } from "@/components/forms/ContactForm";
import { SITE } from "@/consts";
import DefaultLayout from "@/layouts/DefaultLayout.astro";
---

<DefaultLayout
  title="Contact"
  description="Tell me what is slow or manual in your business. I reply within one business day with a range and a next step."
>
  <section
    class="container grid gap-12 pt-28 pb-16 lg:grid-cols-[1fr_1.4fr] lg:pt-40"
  >
    <div>
      <p class="text-primary font-mono text-xs tracking-widest uppercase">
        Contact
      </p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight md:text-5xl">
        Three sentences is enough.
      </h1>
      <p class="text-muted-foreground mt-4 text-lg">
        What you do, what&rsquo;s slow, and roughly how many people it affects.
        I&rsquo;ll reply within one business day.
      </p>
      <dl class="mt-10 space-y-4 text-sm">
        <div>
          <dt class="font-semibold">Phone</dt>
          <dd><a class="hover:underline" href={SITE.phoneHref}>{SITE.phone}</a></dd>
        </div>
        <div>
          <dt class="font-semibold">Email</dt>
          <dd>
            <a class="hover:underline" href={`mailto:${SITE.email}`}>
              {SITE.email}
            </a>
          </dd>
        </div>
        <div>
          <dt class="font-semibold">Elsewhere</dt>
          <dd class="flex gap-4">
            <a
              class="hover:underline"
              href={SITE.linkedin}
              target="_blank"
              rel="noreferrer">LinkedIn</a
            >
            <a
              class="hover:underline"
              href={SITE.github}
              target="_blank"
              rel="noreferrer">GitHub</a
            >
          </dd>
        </div>
        <div>
          <dt class="font-semibold">Based in</dt>
          <dd>{SITE.location} — happy to meet on site in the city.</dd>
        </div>
      </dl>
    </div>
    <div class="bg-card rounded-3xl border p-6 md:p-10">
      <ContactForm client:load />
    </div>
  </section>
</DefaultLayout>
