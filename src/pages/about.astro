---
import CtaBand from "@/components/site/CtaBand.astro";
import { buttonVariants } from "@/components/ui/button";
import { SITE } from "@/consts";
import DefaultLayout from "@/layouts/DefaultLayout.astro";

const timeline = [
  {
    when: "2026 –",
    what: "Independent: Measure Blinds for Blinds Nisa (live), Calculo (own product), Meet Your Neighbour (community).",
  },
  {
    when: "Jan 2026 –",
    what: "Social media manager, Northern Lights Educational Services.",
  },
  {
    when: "Summer 2025",
    what: "Software developer intern, PLAY — built Employee Log Keeper for 30+ staff.",
  },
  {
    when: "Summer 2024",
    what: "Software engineering intern, Antimony Tech — custom web apps for small-business clients (Node.js, TypeScript, Tailwind).",
  },
  {
    when: "Ongoing",
    what: "Operations and technical partner in a family custom millwork & cabinetry business: quoting, sourcing, 3D modelling.",
  },
  {
    when: "2022 – 2027",
    what: "B.Eng. Software Engineering (co-op), Carleton University, Ottawa. Expected graduation May 2027.",
  },
];
---

<DefaultLayout
  title="About"
  description="Kemal Sogut is a software engineer in Ottawa who builds custom web apps for local businesses, and grew up in a trades business."
>
  <section
    class="container grid gap-12 pt-28 lg:grid-cols-[1.2fr_1fr] lg:pt-40"
  >
    <div>
      <p class="text-primary font-mono text-xs tracking-widest uppercase">
        About
      </p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight md:text-5xl">
        I grew up in a business that measures, quotes and installs. Now I write
        the software for businesses like it.
      </h1>
      <div class="prose prose-neutral dark:prose-invert mt-8 max-w-none">
        <p>
          I&rsquo;m Kemal, a software engineer in Ottawa. My family runs a
          custom cabinetry and millwork shop, so I know what a quote that takes
          three days costs you, and what happens when a measurement is written
          down wrong.
        </p>
        <p>
          I build web apps that fix exactly those problems: a field estimator
          that prices ten blind types on a tablet and lets the customer confirm
          by email, a logging tool that thirty staff used from day one, an
          invoicing product that turns estimates into invoices and receipts.
        </p>
        <h3>Why one engineer instead of an agency</h3>
        <ul>
          <li>
            <strong>You talk to the person writing the code.</strong> No account
            manager translating your process to someone you never meet.
          </li>
          <li>
            <strong>Lower overhead, same tools.</strong> I use the same stack a
            good agency would (TypeScript, React, Postgres, Cloudflare) without
            the office.
          </li>
          <li>
            <strong>Small enough to care about a $10k project.</strong> Most
            agencies aren&rsquo;t.
          </li>
        </ul>
        <h3>What I&rsquo;m not</h3>
        <p>
          I&rsquo;m not a team of ten. If you need a 40-screen enterprise
          platform on a six-week deadline, I&rsquo;ll say so on the first call
          and point you somewhere better.
        </p>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/contact" class={buttonVariants()}>Start a project</a>
        <a
          href={SITE.linkedin}
          target="_blank"
          rel="noreferrer"
          class={buttonVariants({ variant: "outline" })}
        >
          LinkedIn
        </a>
        <a
          href={SITE.github}
          target="_blank"
          rel="noreferrer"
          class={buttonVariants({ variant: "outline" })}
        >
          GitHub
        </a>
      </div>
    </div>
    <aside>
      <img
        src="/about/kemal.jpg"
        alt="Kemal Sogut"
        class="aspect-[4/5] w-full rounded-3xl border object-cover"
        onerror="this.style.display='none'"
      />
      <ol class="mt-8 space-y-4 border-l pl-6">
        {
          timeline.map((t) => (
            <li>
              <p class="text-muted-foreground font-mono text-xs">{t.when}</p>
              <p class="mt-1 text-sm">{t.what}</p>
            </li>
          ))
        }
      </ol>
    </aside>
  </section>
  <CtaBand />
</DefaultLayout>
