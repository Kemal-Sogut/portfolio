---
import { Background } from "@/components/background";
import { buttonVariants } from "@/components/ui/button";
import DefaultLayout from "@/layouts/DefaultLayout.astro";
---

<DefaultLayout
  title="404: Not Found"
  description="That page isn't here. Try the work or pricing pages, or tell me what you were looking for."
>
  <Background>
    <div
      class="container flex min-h-[70vh] flex-col items-center justify-center py-28 text-center lg:min-h-[80vh] lg:py-32"
    >
      <div class="max-w-2xl">
        <p class="text-primary font-mono text-xs tracking-widest uppercase">
          404
        </p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight md:text-5xl">
          That page isn&rsquo;t here.
        </h1>
        <p class="text-muted-foreground mt-4 text-lg">
          Try the work or pricing pages, or tell me what you were looking for.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="/work" class={buttonVariants({ size: "lg" })}>See the work</a>
          <a
            href="/pricing"
            class={buttonVariants({ size: "lg", variant: "outline" })}
          >
            Pricing
          </a>
          <a
            href="/contact"
            class={buttonVariants({ size: "lg", variant: "outline" })}
          >
            Contact
          </a>
        </div>
      </div>
    </div>
  </Background>
</DefaultLayout>
